INVESTMENT_MAS_APP_ENV=prod
INVESTMENT_MAS_DEBUG=false
INVESTMENT_MAS_LOG_LEVEL=INFO
INVESTMENT_MAS_DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/investment_mas
INVESTMENT_MAS_FINANCIAL_DATA_PROVIDER=hybrid
INVESTMENT_MAS_NEWS_PROVIDER=web
INVESTMENT_MAS_COMPANY_INFO_PROVIDER=web
INVESTMENT_MAS_LOCAL_FINANCIAL_BASE_DIR=/data/finance_report_web
INVESTMENT_MAS_ENABLE_FUTU_DOWNLOAD_FALLBACK=true
INVESTMENT_MAS_FUTU_DOWNLOADER_SCRIPT_PATH=/app/scripts/download_financial_data.py
INVESTMENT_MAS_FUTU_DOWNLOAD_TIMEOUT_SECONDS=300
INVESTMENT_MAS_ENABLE_SUPPLEMENTAL_VALUATION=true
INVESTMENT_MAS_SUPPLEMENTAL_VALUATION_SCRIPT_PATH=/app/scripts/run_value_analysis_by_code.py
INVESTMENT_MAS_SUPPLEMENTAL_VALUATION_HELPER_PATH=/app/scripts/value_investment_market_value.py
INVESTMENT_MAS_SUPPLEMENTAL_VALUATION_WORKBOOK=/app/data/value_analysis_by_code.xlsx
INVESTMENT_MAS_SUPPLEMENTAL_FX_WORKBOOK=/app/data/Value_Investment.xlsx
INVESTMENT_MAS_DASHSCOPE_API_KEY=
INVESTMENT_MAS_DASHSCOPE_CONFIG_PATH=
INVESTMENT_MAS_DASHSCOPE_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
INVESTMENT_MAS_DASHSCOPE_MODEL=auto  # Available: auto, qwen3.8-max, qwen3.8-flash, qwen3.7-plus, deepseek-v4.1-flash, deepseek-v4-pro, glm-5.3
INVESTMENT_MAS_DASHSCOPE_TEMPERATURE=0.2
INVESTMENT_MAS_DASHSCOPE_MAX_TOKENS=
INVESTMENT_MAS_ENABLE_LLM_REPORT=true
INVESTMENT_MAS_WEB_REQUEST_TIMEOUT_SECONDS=20
INVESTMENT_MAS_WEB_USER_AGENT=investment-mas/0.1 (ecs deployment)
INVESTMENT_MAS_NEWS_FETCH_LIMIT=8
POSTGRES_DB=investment_mas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
APP_PORT=8000
